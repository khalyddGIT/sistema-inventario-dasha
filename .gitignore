# ==========================================
# Complete & Comprehensive .gitignore System
# ==========================================

# 1. Node.js & Angular Frontend
node_modules/
dist/
frontend/dist/
.angular/
frontend/.angular/
.nx/
.tmp/
.sass-cache/
connect.lock
coverage/
chrome-profiler-events*.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# 2. Java & Maven Backend
target/
backend/target/
*.class
*.jar
*.war
*.ear
*.log
backend/mvn-error.log
backend/mvn-output.log
backend/uploads/*
!backend/uploads/README.md

# 3. Environment & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 4. IDEs & Editors (VSCode, IntelliJ, Eclipse, NetBeans)
.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
*.swp
*.swo

# 5. Operating System Junk
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# 6. Agent & CLI Cache
.agents/
.gemini/
.tempmediaStorage/

.vercel
.env*
